# Base URL of the Django backend.
# Leave EMPTY in development — the Vite dev server proxies /gmail, /stripe and
# /api to http://localhost:8000 (see vite.config.js), so requests stay
# same-origin. Set this for production builds where the API lives elsewhere,
# e.g. VITE_API_BASE_URL=https://api.paypulse.app
VITE_API_BASE_URL=

# Backend route that kicks off the Gmail OAuth 2.0 flow (GmailAuthInitView).
VITE_GMAIL_AUTH_PATH=/gmail/auth/

# Backend route that stores a user's Stripe account details.
VITE_STRIPE_CONNECT_PATH=/stripe/connect/
