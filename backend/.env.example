DJANGO_SECRET_KEY=<your-secret-key>
DJANGO_DEBUG=<your-debug-value>
DJANGO_ALLOWED_HOSTS=<your-allowed-hosts>

DATABASE_URL=<your-database-url>
REDIS_URL=<your-redis-url>


GMAIL_CLIENT_ID=<your-gmail-client-id>
GMAIL_CLIENT_SECRET=<your-gmail-client-secret>
STRIPE_SECRET_KEY=<your-stripe-secret-key>
OPENAI_API_KEY=<your-openai-api-key>

FERNET_KEY=<your-fernet-key>

# Where the OAuth callback sends the user back to (the React SPA).
FRONTEND_URL=http://localhost:5173

# In dev, point the Google redirect URI at the SAME origin as the SPA so the
# Vite proxy keeps the session cookie same-origin, e.g.
#   http://localhost:5173/gmail/callback/
GMAIL_REDIRECT_URI=<your-gmail-redirect-uri>
GMAIL_SCOPES=<your-gmail-scopes>
GMAIL_AUTH_URL=https://accounts.google.com/o/oauth2/auth
GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token